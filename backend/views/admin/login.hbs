<div class="login-box">
  <h1>Admin Carri-GO</h1>
  <p class="sub">Ingresá con tu Gmail de administrador</p>

  {{#if error}}
    <p class="error">{{#if message}}{{message}}{{else}}Datos incorrectos{{/if}}</p>
  {{/if}}

  <form action="/admin/login" method="POST">
    <label>Email</label>
    <input type="email" name="email" required placeholder="tu@gmail.com" />

    <label>Contraseña</label>
    <input type="password" name="password" required />

    <button type="submit">Ingresar</button>
  </form>
</div>