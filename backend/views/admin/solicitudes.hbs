<header class="admin-header">
  <h1>Panel Admin — Carri-GO</h1>
  <div class="admin-user">
    <span>{{admin.email}}</span>
    <a href="/admin/login/logout">Cerrar sesión</a>
  </div>
</header>

<div class="container">
  {{#if error}}
    <p class="error">{{error}}</p>
  {{/if}}

  <div class="secciones">
    <!-- ========== SECCIÓN DELIVERY ========== -->
    <section class="seccion seccion-delivery">
      <div class="seccion-header">
        <div>
          <span class="badge badge-delivery">Delivery</span>
          <h2>Platos pendientes</h2>
        </div>
        <span class="contador">{{productos.length}}</span>
      </div>

      {{#if productos.length}}
        <div class="lista-cards">
          {{#each productos}}
            <div class="card">
              <div class="card-info">
                <strong>{{nombre}}</strong>
                {{#if descripcion}}
                  <p class="meta">{{descripcion}}</p>
                {{/if}}
                <p class="precio">${{precio}} · {{restaurante_nombre}}</p>
              </div>
              <div class="acciones">
                <a class="btn-ok" href="/admin/productos/{{id}}/aprobar">Aprobar</a>
                <a class="btn-no" href="/admin/productos/{{id}}/rechazar">Rechazar</a>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="vacio">No hay platos pendientes de aprobación.</p>
      {{/if}}
    </section>

    <!-- ========== SECCIÓN ENCARGOS ========== -->
    <section class="seccion seccion-encargos">
      <div class="seccion-header">
        <div>
          <span class="badge badge-encargos">Encargos</span>
          <h2>Servicios de repartidor pendientes</h2>
        </div>
        <span class="contador">{{servicios.length}}</span>
      </div>

      {{#if servicios.length}}
        <div class="lista-cards">
          {{#each servicios}}
            <div class="card">
              <div class="card-info">
                <strong>{{nombre}} {{apellido}}</strong>
                <p class="meta">📍 {{zona}} · {{vehiculo}} · 📦 {{capacidad}}</p>
                <p class="meta">Tel: {{telefono}}</p>
              </div>
              <div class="acciones">
                <a class="btn-ok" href="/admin/servicios/{{id}}/aprobar">Aprobar</a>
                <a class="btn-no" href="/admin/servicios/{{id}}/rechazar">Rechazar</a>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="vacio">No hay servicios pendientes de aprobación.</p>
      {{/if}}
    </section>
  </div>
</div>